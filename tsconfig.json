{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "leaflet": ["./assets/ts/leaflet.d.ts"],
      "ts/*": ["./themes/projektemacher-base/assets/ts/*", "./assets/ts/*"]
    }
  },
  "include": ["assets/ts/**/*.ts", "assets/js/**/*.js", "themes/projektemacher-base/assets/ts/*.d.ts"]
}
